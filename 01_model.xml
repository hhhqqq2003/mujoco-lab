<mujoco model="lesson01">
  <!-- 这是第 1 课的模型：一个小场景，覆盖 MuJoCo 的核心概念。
       随便改数值，保存后重跑：
           python3 01_model_and_data.py        # 看数据
           python3 view_xml.py                 # 开窗看（默认就是这个文件）
           python3 view_xml.py 01_model.xml --png   # 只存图，不开窗
  -->

  <!-- 物理设置：时间步 2 ms；重力朝下；implicitfast 是默认积分器 -->
  <option timestep="0.02" gravity="0 0 -9.81" integrator="implicitfast"/>

  <visual>
    <global offwidth="640" offheight="480"/>
  </visual>

  <!-- 资源：棋盘格地面贴图 -->
  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1=".25 .3 .35"
             rgb2=".35 .4 .45" width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="6 6"/>
  </asset>

  <worldbody>
    <light pos="0 0 4" directional="true"/>

    <!-- plane 是无限大的地面，只能放在 worldbody 里（它不需要 body） -->
    <geom name="ground" type="plane" size="4 4 0.1" material="grid"/>

    <!-- 自由落体的箱子：freejoint = 6 自由度（3 平移 + 3 转动）
         注意：qpos 里是 7 个数 [x y z qw qx qy qz]，但只有 6 个自由度 -->
    <body name="box" pos="0 0 1.5">
      <freejoint name="box_free"/>
      <geom name="box_geom" type="box" size="0.12 0.12 0.12"
            rgba="0.9 0.45 0.2 1" friction="0.8 0.1 0.1"/>
    </body>

    <!-- 门一样的摆：hinge 绕 z 轴，1 自由度；面板从铰链处伸出 0.35 m -->
    <body name="door" pos="-0.8 0 0.9">
      <joint name="door_hinge" type="hinge" axis="0 0 1" damping="0"/>
      <geom name="door_panel" type="box" size="0.02 0.35 0.35" pos="0 0.35 0"
            rgba="0.2 0.6 0.9 1"/>
    </body>
  </worldbody>

  <actuator>
    <!-- position 执行器：data.ctrl 写「期望角度」，内部自动做 PD（kp / kv） -->
    <motor name="door_motor" joint="door_hinge" gear="1" ctrlrange="-2 2" forcerange="-2 2"/>>
  </actuator>

  <sensor>
    <!-- 传感器：把状态「读」出来，结果在 data.sensordata 里 -->
    <jointpos name="door_angle" joint="door_hinge"/>
    <framepos name="box_pos" objtype="body" objname="box"/>
  </sensor>
</mujoco>
